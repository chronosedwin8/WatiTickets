NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ── Base de datos PostgreSQL local ─────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=ticketwati
PGUSER=postgres
PGPASSWORD=tu-password-de-postgres
PGSSL=false

# ── Autenticación ──────────────────────────────────────────
JWT_SECRET=genera-uno-con-node-crypto-randomBytes-48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=10
ALLOW_PUBLIC_SIGNUP=false

# ── Red ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_PUBLIC_URL=http://localhost:3000

# ── Almacenamiento de adjuntos ─────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_MAX_FILE_MB=25

# ── Correo saliente (rellenar para activar notificaciones) ─
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=soporte@tudominio.com
MAIL_FROM_NAME=TicketWati

# ── Agente de inventario (script Python) ───────────────────
HARDWARE_AGENT_KEY=genera-una-clave-para-el-agente
